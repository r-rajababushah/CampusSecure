# SecureCampus Environment Configuration
# Copy this to .env for local overrides

# Application Port and Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Server-Side Session Security & Cryptography
# Use high-entropy random strings (min 32 bytes) in production
SESSION_SECRET=securecampus-dev-session-key-change-in-production-32-chars-min
CSRF_SECRET=securecampus-dev-csrf-key-change-in-production-32-chars-min

# Attendance Integrity Secret (Stored outside DB for HMAC-SHA256 canonical verification)
HMAC_ATTENDANCE_SECRET=securecampus-attendance-hmac-secret-key-32b

# Database connection (Defaults to local embedded persistent document store if not specified)
# MONGODB_URI=mongodb://localhost:27017/securecampus

# CORS Configuration (Restricted origin)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_MAX=300

# Required by AI Studio
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
